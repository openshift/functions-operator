# The func binary is built and productized separately from its own rhel9 build
# (see knative.dev/func/Dockerfile.func.rhel9); pull it from that image instead
# of building it from source here.
ARG FUNC_CLI_IMG=quay.io/redhat-user-workloads/ocp-serverless-tenant/functions-func@sha256:93450e06b4aeef0afa1d8e380fc2af9146c4eebdf4caab22f6c318fdd5459648

# Build the manager binary
FROM registry.ci.openshift.org/openshift/release:rhel-9-release-golang-1.26-openshift-5.0 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# The builder image defaults GOFLAGS to -mod=vendor, but this repo's
# dependencies aren't vendored into the build context, so switch back to
# normal module mode.
ENV GOFLAGS=''
# FIPS-compliant build, matching knative.dev/func's rhel9 images.
ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the go source
COPY cmd/func-operator/main.go cmd/func-operator/main.go
COPY api/ api/
COPY internal/ internal/

# Build
# the GOARCH has not a default value to allow the binary be built according to the host where the command
# was called. For example, if we call make docker-build in a local env which has the Apple Silicon M1 SO
# the docker BUILDPLATFORM arg will be linux/arm64 when for Apple x86 it will be linux/amd64. Therefore,
# by leaving it empty we can ensure that the container and binary shipped on it will have the same platform.
RUN GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a \
	-tags strictfipsruntime,exclude_graphdriver_btrfs \
	-o manager cmd/func-operator/main.go

FROM $FUNC_CLI_IMG AS func-cli

FROM registry.access.redhat.com/ubi9/ubi-minimal AS prod
WORKDIR /
COPY --from=builder /workspace/manager .
COPY --from=func-cli /usr/bin/func /func/func
COPY LICENSE /licenses/
USER 65532:65532

ENTRYPOINT ["/manager"]
