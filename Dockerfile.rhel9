# The func binary is built and productized separately from its own rhel9 build
# (see https://github.com/openshift/functions/blob/main/Dockerfile.func.rhel9);
# pull it from that image instead of building it from source here.
ARG FUNC_CLI_IMG=quay.io/redhat-user-workloads/ocp-serverless-tenant/functions-func@sha256:1f62d0803968054ee270e59ac995801e24d7b22ab2d203d3c184a86341abb66c

ARG GO_BUILDER=registry.ci.openshift.org/openshift/release:rhel-9-release-golang-1.26-openshift-5.0@sha256:2794558986b3daeb5e4dc57fb9fd5f7b0812599192d4ff0a1a8247791a38ca60
ARG GO_RUNTIME=registry.access.redhat.com/ubi9/ubi-minimal@sha256:7fbeae18dc9476399f565e68255f602a3374ea8614ba3d14843565131a13ff93

# Build the manager binary
FROM $GO_BUILDER AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

# The builder image defaults GOFLAGS to -mod=vendor, but this repo's
# dependencies aren't vendored into the build context, so switch back to
# normal module mode.
ENV GOFLAGS=''
# FIPS-compliant build, matching knative.dev/func's rhel9 images.
ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
# Copy the go source
COPY cmd/func-operator/main.go cmd/func-operator/main.go
COPY api/ api/
COPY internal/ internal/

# Build
# the GOARCH has not a default value to allow the binary be built according to the host where the command
# was called. For example, if we call make docker-build in a local env which has the Apple Silicon M1 SO
# the docker BUILDPLATFORM arg will be linux/arm64 when for Apple x86 it will be linux/amd64. Therefore,
# by leaving it empty we can ensure that the container and binary shipped on it will have the same platform.
RUN if [ -f /cachi2/cachi2.env ]; then source /cachi2/cachi2.env; fi && \
	GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a \
	-tags strictfipsruntime,exclude_graphdriver_btrfs \
	-o manager cmd/func-operator/main.go

FROM $FUNC_CLI_IMG AS func-cli

FROM $GO_RUNTIME AS prod
WORKDIR /
COPY --from=builder /workspace/manager .
COPY --from=func-cli /usr/bin/func /func/func
COPY LICENSE /licenses/
USER 65532:65532

LABEL name="openshift-serverless-tech-preview/functions-rhel9-operator" \
      com.redhat.component="openshift-serverless-functions-operator-container" \
      version="2.0" \
      release="1" \
      summary="OpenShift Serverless Functions operator" \
      description="Manages the lifecycle of the OpenShift Serverless Functions components" \
      io.k8s.display-name="OpenShift Serverless Functions operator" \
      io.k8s.description="Manages the lifecycle of the OpenShift Serverless Functions components" \
      io.openshift.tags="openshift,serverless,functions,operator" \
      maintainer="serverless-support@redhat.com"

ENTRYPOINT ["/manager"]
